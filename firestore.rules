rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Es administrador de iogga? El fundador siempre; los demás, si un admin
    // los agregó a la colección /admins (documento con id = su correo).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'omareduardo_@hotmail.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // Administradores: solo un admin puede ver o modificar la lista.
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // Pagos (Mercado Pago): los escribe SOLO el backend (Functions).
    // El admin ve todos; cada usuario puede ver los suyos.
    match /payments/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Configuración del Marketplace de Mercado Pago (client_id y client_secret de
    // iogga). Solo un admin la escribe desde el panel; NADIE la lee desde la app
    // (el backend la lee con permisos de servidor). Así el secreto no queda expuesto.
    match /config/{doc} {
      allow write: if isAdmin();
      allow read: if false;
    }

    // Cuentas de Mercado Pago conectadas por cada negocio (tokens del vendedor
    // obtenidos por OAuth). SOLO el backend las escribe/lee; nunca el cliente.
    match /mp_sellers/{uid} {
      allow read, write: if false;
    }

    // Perfiles de usuarios: cada quien puede leer perfiles,
    // pero solo editar el suyo.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Planes: cualquiera puede explorarlos (estilo TikTok, sin login).
    // Publicar requiere cuenta; editar/borrar solo el dueño.
    match /plans/{planId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Promociones de negocios: cualquiera puede verlas.
    // Publicar requiere cuenta; editar/borrar solo el dueño.
    match /promos/{promoId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Libro contable de IOGGA (comisiones e ingresos de la app).
    // Se escribe desde la app al validar; solo los administradores lo leen.
    match /ledger/{entry} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Sugerencias e ideas de usuarios (las lee el panel de administración).
    match /feedback/{entry} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Amigos (modelo Instagram): sigues = solicitud pendiente.
    // - Crear: solo tú puedes crear TU follow (queda en 'pending').
    // - Actualizar: solo la persona SEGUIDA puede aceptar la solicitud.
    // - Borrar: el seguidor (dejar de seguir / cancelar solicitud) o el
    //   seguido (rechazar solicitud / quitar seguidor).
    match /follows/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.follower == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.following == request.auth.uid
        && request.resource.data.status == 'accepted'
        && request.resource.data.follower == resource.data.follower
        && request.resource.data.following == resource.data.following;
      allow delete: if request.auth != null
        && (resource.data.follower == request.auth.uid || resource.data.following == request.auth.uid);
    }

    // Notificaciones: cualquiera logueado puede enviar una a otro usuario;
    // solo el destinatario puede leerlas y marcarlas como leídas.
    match /notifications/{id} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && resource.data.to == request.auth.uid;
      allow delete: if false;
    }

    // Canjes QR: un usuario logueado crea su código;
    // el negocio (cualquier usuario logueado) lo lee y lo marca como usado.
    match /redemptions/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.status == 'redeemed'
        && resource.data.status == 'pending';
    }
  }
}
